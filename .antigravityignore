# .antigravityignore — Context Filter for xiaozhi-server
# Soft AI context filter (Layer 3). Pair sensitive paths with Layer 1 permissions.deny
# (Strict Mode) and Layer 2 .gitignore. Keeps active source code, docs, tests, and templates readable.

# ==============================================================================
# 1. Workspace bloat, runtime state & private data
#    (Note: data/ root is kept readable because core *.ps1 scripts live there)
# ==============================================================================
models/
backups/
anima-data/
state/
config/runtime/
pc-mcp/state/
voices/
logs/
tmp/
data/obsidian_export/
data/anima/
data/agy_tasks/
data/voices/
data/nvs*
data/chat_history.json
data/pc_mcp_token.txt
data/last_som_grounding.jpg
data/*.migrated.bak
data/anima_outbox.sqlite*
data/memory_archives.sqlite*

