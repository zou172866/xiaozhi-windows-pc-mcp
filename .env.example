# =====================================================================
# 小智 ESP32 本地服务端环境变量模板 (.env.example)
# 复制为根目录 .env（或直接双击「一键初始化配置.bat」自动生成）
# 注意：.env 已被 .gitignore 排除，绝不会被推送至公开仓库；
#       API 密钥推荐直接配置到 Windows 系统环境变量，避免明文落盘。
# =====================================================================

# ---------- 1. 基础网络与路径（留空时启动脚本会自动探测） ----------
# 本机局域网 IPv4（供 ESP32 连接 18000 WebSocket 与 18003 OTA）
HOST_LAN_IP=192.168.1.100

# ---------- 2. L3 后台重装 Agent 引擎（可在 18080 控制台免重启随时热切） ----------
# 可选值: dsh | workbuddy | antigravity | none
# - dsh:         DeepSeek Harness (@deepseek-ai/dsh --profile headless，国内直连，推荐)
# - workbuddy:   腾讯 WorkBuddy / CodeBuddy CLI (workbuddy / codebuddy / cbc -p，国内直连)
# - antigravity: Google Antigravity 官方 Sidecar 桥接
# - none:        关闭 L3，仅启用 L1 系统控制与 L2 视觉键鼠
L3_BACKEND=dsh

# L3 后台任务默认工作目录（留空则自动使用 xiaozhi-server 的上级目录）
# XIAOZHI_L3_WORKDIR=D:\Projects

# 可选：若 CLI 未加入系统 PATH，可手动指定命令路径
# DSH_CMD=dsh
# WORKBUDDY_CMD=codebuddy

# ---------- 3. 语音合成（无独显电脑保持 false，自动走内置免显存 EdgeTTS） ----------
ENABLE_LOCAL_GSV=false
# 若本机部署了 RTX GPU GPT-SoVITS，将上面改为 true 并填目录（留空自动探测 ..\gpt-sovits-studio）
# GSV_DIR=D:\gpt-sovits-studio

# ---------- 4. Anima Brain 长期记忆模型配置 ----------
# 【方案 A：纯国内免梯子（推荐给无代理的 Windows 电脑）】
#   对话摘要与事实抽取走 DeepSeek，向量检索走国内 OpenAI 兼容 Embedding（如硅基流动 BAAI/bge-m3 或阿里云百炼）
ANIMA_LLM_BASE_URL=https://api.deepseek.com/v1
ANIMA_LLM_MODEL=deepseek-chat
# ANIMA_LLM_API_KEY 留空时请通过 Windows 环境变量设置，或直接与 DEEPSEEK_API_KEY 相同
# ANIMA_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# ANIMA_EMBEDDING_MODEL=BAAI/bge-m3
# ANIMA_EMBEDDING_API_KEY=

# 【方案 B：Google Gemini（需要代理/全局 TUN，取消下方注释并注释上方方案 A）】
# ANIMA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ANIMA_LLM_MODEL=gemini-3.5-flash-lite
# ANIMA_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ANIMA_EMBEDDING_MODEL=gemini-embedding-001
