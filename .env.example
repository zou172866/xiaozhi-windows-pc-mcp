# =====================================================================
# 小智 ESP32 本地服务端环境变量模板 (.env.example)
# 复制为根目录 .env（或直接双击「一键初始化配置.bat」自动生成）
# 注意：.env 已被 .gitignore 排除，绝不会被推送至公开仓库；
#       API 密钥推荐直接配置到 Windows 系统环境变量，避免明文落盘。
# =====================================================================

# ---------- 1. 基础网络与 ESP32 通道鉴权（留空时启动脚本会自动探测/生成） ----------
# 本机局域网 IPv4（供 ESP32 连接 18000 WebSocket 与 18003 OTA）
HOST_LAN_IP=192.168.1.100

# 设备签名密钥由初始化或启动脚本通过 Windows DPAPI 加密保存，并注入启动环境。
# 允许接入 18000 WebSocket / 18003 OTA / 18003 视觉分析的 ESP32 MAC 白名单（多个用英文逗号分隔，如 aa:bb:cc:dd:ee:ff）
# 开启鉴权后必须填入真实 ESP32 MAC，否则所有设备均会被拒绝（fail-closed）；也可留空，启动后在 18080 控制台一键放行
ESP32_ALLOWED_DEVICES=

# ---------- 1b. 国内镜像与构建加速（可选，默认使用官方 digest 锁定源） ----------
# 主容器上游镜像覆盖（start_all.ps1 拉取 ghcr.nju.edu.cn 失败时会自动回退 ghcr.io 同 digest 镜像）
# XIAOZHI_SERVER_IMAGE=ghcr.io/xinnan-tech/xiaozhi-esp32-server:server_latest@sha256:cececd7752e00e044bf9f099751a140834053573bbe6dd55ecbcedcb20c19c25
# anima-brain Docker 基础镜像前缀（仍强制校验原 @sha256 digest，例如 docker.m.daocloud.io/library/）
# DOCKER_MIRROR_PREFIX=
# anima-brain 构建期 npm / pip 国内镜像源（纯国内环境强烈建议取消注释加速首次构建）
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=

# ---------- 2. L3 后台重装 Agent 引擎（仅 backend/timeout 可在 18080 热切；命令与目录仅读宿主机 .env） ----------
# 可选值: dsh | workbuddy | antigravity | none
# - dsh:         DeepSeek Harness (@deepseek-ai/dsh --profile headless，国内直连，推荐)
# - workbuddy:   腾讯 WorkBuddy / CodeBuddy CLI (workbuddy / codebuddy / cbc -p，国内直连)
# - antigravity: Google Antigravity 官方 Sidecar 桥接
# - none:        关闭 L3，仅启用 L1 系统控制与 L2 视觉键鼠
L3_BACKEND=dsh

# 以下 4 项为宿主机只读安全配置（容器与 18080 控制台均不可改写，切断容器到宿主机命令注入）
# L3 后台任务默认工作目录（留空则自动使用 xiaozhi-server 的上级目录）
# XIAOZHI_L3_WORKDIR=D:\Projects
# 可选：若 CLI 未加入系统 PATH，可手动指定命令路径
# DSH_CMD=dsh
# WORKBUDDY_CMD=codebuddy
# WorkBuddy 是否自动批准执行（默认 false；仅在明确信任宿主机任务时改为 true）
WORKBUDDY_AUTO_APPROVE=false

# ---------- 3. 语音合成与云端音频 API（无独显/低配电脑强烈推荐纯云端或 EdgeTTS） ----------
ENABLE_LOCAL_GSV=false
# 若本机部署了 RTX GPU GPT-SoVITS，将上面改为 true 并填目录（留空自动探测 ..\gpt-sovits-studio）
# GSV_DIR=D:\gpt-sovits-studio
# 可选：自定义本地 GPT-SoVITS 角色模型权重路径（留空默认保留现有 tts_infer_xiaozhi.yaml 自定义权重或 models/gsv_weights/raiden_mei/v4/{gpt.ckpt,sovits.pth}）
# GSV_MEI_GPT_WEIGHTS=
# GSV_MEI_SOVITS_WEIGHTS=
# GSV_MEI_VERSION=v4
# 可选：罗小黑独立槽位权重覆盖（留空默认读取 models/gsv_weights/luoxiaohei/v5turbo/{gpt.ckpt,sovits.pth}）
# GSV_LXH_GPT_WEIGHTS=
# GSV_LXH_SOVITS_WEIGHTS=
# GSV_LXH_VERSION=v5turbo

# 云端音频 API（ASR + TTS）环境变量说明：
# 强烈建议通过「一键初始化配置.bat」写入 Windows 用户环境变量（零明文落盘）；
# 若仅本地测试，也可在下方取消注释填写（.env 已被 .gitignore 忽略，绝不会提交入库）。
# 1) 硅基流动 SiliconFlow（低配国内直连首选：SenseVoiceSmall ASR + CosyVoice2 TTS 共用 1 个 Key）
# SILICONFLOW_API_KEY=
# 2) 通用 OpenAI 兼容协议（OpenAI / Groq / One-API / New-API / 自建 Whisper & TTS）
# OPENAI_AUDIO_API_KEY=
# 3) 阿里云百炼 DashScope（Qwen3-ASR-Flash / Paraformer 实时流式 ASR + CosyVoice 双向流式 TTS）
# DASHSCOPE_API_KEY=
# 4) 火山引擎豆包语音（若 ASR 与 TTS 共用同一个应用，只需填 DOUBAO_APPID 与 DOUBAO_ACCESS_TOKEN；也可按需分填）
# DOUBAO_APPID=
# DOUBAO_ACCESS_TOKEN=
# DOUBAO_ASR_APPID=
# DOUBAO_ASR_ACCESS_TOKEN=
# DOUBAO_TTS_APPID=
# DOUBAO_TTS_ACCESS_TOKEN=
# 5) Fish Audio（云端或自建 Fish Speech 音色克隆）
# FISHSPEECH_API_KEY=
# 6) MiniMax 海螺语音 T2A V2
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
# 可选：云端 ASR HTTP 请求超时秒数（默认 20）与流式 TTS 电脑音响直通采样率上限（默认 48000 / MiniMax 44100）
# CLOUD_ASR_TIMEOUT_SECONDS=20
# PC_AUDIO_STREAM_SAMPLE_RATE=48000

# ---------- 4. Anima Brain 长期记忆模型配置 ----------
# 可选：后台记忆整理超时与单批消息数（默认 150 秒 / 8 条）
# ANIMA_TIMEOUT_SECONDS=150
# 多家庭成员 / 多 ESP32 独立记忆映射（默认各设备严格隔离温召回缓存；如需按设备拆分为完全独立角色库可取消注释）：
# ANIMA_DEVICE_CHARACTER_MAP=aa:bb:cc:11:22:33=kid_room,dd:ee:ff:44:55:66=study_room
# ANIMA_ISOLATE_CHARACTER_BY_DEVICE=false
# ANIMA_SUMMARY_BATCH_MESSAGES=8
# 可选：将后台记忆总结单独切到更稳的低延迟通道（留空则复用 ANIMA_LLM_*）
# ANIMA_SUMMARY_BASE_URL=https://api.deepseek.com/v1
# ANIMA_SUMMARY_MODEL=deepseek-chat
# ANIMA_SUMMARY_API_KEY=
# 可选：Anima 后台总结自动灾备节点（仅在确定性 429/502/503/504/建连失败时切备，绝不重复扣费）
# ANIMA_SUMMARY_FALLBACK_BASE_URL=
# ANIMA_SUMMARY_FALLBACK_MODEL=
# ANIMA_SUMMARY_FALLBACK_API_KEY=

# 【方案 A：纯国内免梯子（推荐给无代理的 Windows 电脑；docker-compose 默认即为本方案）】
#   对话摘要与事实抽取走 DeepSeek；ANIMA_LLM_API_KEY 留空时会自动复用 DEEPSEEK_API_KEY
#   下面 Embedding 留空即纯本地 FTS5 运行，不回落 Google Gemini
ANIMA_LLM_BASE_URL=https://api.deepseek.com/v1
ANIMA_LLM_MODEL=deepseek-chat
# 如需单独指定记忆模型 Key，可在系统环境变量设置 ANIMA_LLM_API_KEY（留空自动匹配 DEEPSEEK_API_KEY / GEMINI_API_KEY）
# 如需启用国内语义向量检索，填入兼容接口（如 https://api.siliconflow.cn/v1 与 BAAI/bge-m3）并把 Key 存入环境变量 ANIMA_EMBEDDING_API_KEY
ANIMA_EMBEDDING_BASE_URL=
ANIMA_EMBEDDING_MODEL=
ANIMA_EMBEDDING_API_KEY=
# 可选：显式指定向量输出维度（多向量空间按 model@dim 隔离共存，切换维度或模型保留旧向量免重建）
# ANIMA_EMBEDDING_DIMENSIONS=
# AutoDream 只读离线反思提案与召回层敏感信息自动拦截（默认开启；零自动发布，需人工审批）
# ANIMA_DREAM_ENABLED=true
# ANIMA_DREAM_INTERVAL_SECONDS=21600
# ANIMA_RECALL_SENSITIVE_FILTER=true

# 【方案 B：Google Gemini（需要代理/全局 TUN，取消下方注释并注释上方方案 A）】
# ANIMA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ANIMA_LLM_MODEL=gemini-3.5-flash-lite
# ANIMA_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# ANIMA_EMBEDDING_MODEL=gemini-embedding-001

# ---------- 5. Obsidian 单向记忆与对话导出（可选） ----------
# 开启后由 Anima Brain 自动将对话流水、长期记忆、未完待续与关系状态单向导出为 Markdown
OBSIDIAN_SYNC_ENABLED=false
# 宿主机 Obsidian Vault 目录（留空默认导出到 ./data/obsidian_export；建议使用正斜杠或普通盘符路径）
# OBSIDIAN_EXPORT_DIR=D:\Obsidian\XiaozhiMemory
# 后台记忆快照检查间隔（秒，默认 600）
OBSIDIAN_SNAPSHOT_INTERVAL_SECONDS=600
# 离线分层梳理：每日/每周待跟进简报（写入 Vault「简报/」目录，零主动语音打扰）
OBSIDIAN_BRIEFING_ENABLED=true
OBSIDIAN_BRIEFING_INTERVAL_SECONDS=3600
# 双向备忘收件箱（默认关闭、零空载扫描；开启后只读监听 Vault「收件箱/」目录，绝不改写原笔记）
OBSIDIAN_INBOX_ENABLED=false
OBSIDIAN_INBOX_INTERVAL_SECONDS=120

# ---------- 6. 国内免代理手机轻量通知推送（可选，默认关闭、零外发） ----------
# 推荐通过系统环境变量或本文件配置凭据（也可在 18080 面板写入 0600 隔离文件，永不进版本库）
# 1) Bark (iOS)：完整设备推送 URL（如 https://api.day.app/你的设备Key）
# MOBILE_PUSH_BARK_URL=
# 2) 飞书群机器人 Webhook 及可选加签密钥
# MOBILE_PUSH_FEISHU_WEBHOOK=
# MOBILE_PUSH_FEISHU_SECRET=
# 3) 企业微信群机器人 Webhook
# MOBILE_PUSH_WECOM_WEBHOOK=
# 4) PushPlus 微信推送 Token
# MOBILE_PUSH_PUSHPLUS_TOKEN=
# 5) Server酱 (Turbo / SC3) SendKey
# MOBILE_PUSH_SERVERCHAN_KEY=

# ---------- 7. QQ 官方机器人双向 WebSocket 桥接（可选，默认关闭、强白名单 fail-closed） ----------
# 凭据仅注入主容器，绝不注入 anima-brain；亦可在 18080 面板写入 state/.qq_bot_secrets.json (0600)
# QQ_BOT_APP_ID=
# QQ_BOT_APP_SECRET=

# ---------- 8. 宿主机 Windows AppContainer 沙箱工作区目录（可选，仅宿主机只读生效） ----------
# 留空默认使用 pc-mcp/state/sandbox_workspace/；容器与 18080 控制台均不可修改
# PC_MCP_SANDBOX_ROOT=
