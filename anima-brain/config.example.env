# Documentation only: no dotenv file is automatically loaded. Never commit real keys.
COMPANION_DB=./brain.sqlite3
# Optional file written only by explicit "Save for local MCP" in Provider settings.
# macOS uses Keychain; the file fallback stores unencrypted keys (0600).
# Environment settings below override saved settings.
# COMPANION_SETTINGS_FILE=~/.config/companion-engine/providers.json
# Standalone UI; MCP host mode needs no reply-model key here.
COMPANION_BASE_URL=
COMPANION_MODEL=
COMPANION_API_KEY=
COMPANION_READER_ENABLED=true
COMPANION_READER_MAX_STEPS=2
COMPANION_MAX_OUTPUT_TOKENS=2048
COMPANION_TIMEOUT_SECONDS=60
# Omit temperature to use the provider default; supported values depend on the model.
# COMPANION_TEMPERATURE=0.7
# Optional vision model (may differ from the text-only chat model).
COMPANION_VISION_BASE_URL=
COMPANION_VISION_MODEL=
COMPANION_VISION_KEY=
COMPANION_VISION_MAX_OUTPUT_TOKENS=1200
# Timeout per media request, including vision; no automatic retries.
COMPANION_MEDIA_TIMEOUT_SECONDS=120
# Optional separate summary model. Empty uses the reply provider when summaries are enabled.
COMPANION_SUMMARY_BASE_URL=
COMPANION_SUMMARY_MODEL=
COMPANION_SUMMARY_KEY=
# Optional semantic memory; index excerpts before expecting semantic matches.
COMPANION_EMBEDDING_BASE_URL=
COMPANION_EMBEDDING_MODEL=
COMPANION_EMBEDDING_KEY=
# elevenlabs, minimax or doubao; character voice_id is configured separately.
# Doubao: speech_model=seed-tts-2.0-expressive, speech_key=the speech API key,
# voice_id=your own S_* cloned speaker; uses the seed-icl-2.0 resource.
COMPANION_SPEECH_PROVIDER=elevenlabs
COMPANION_SPEECH_MODEL=
COMPANION_SPEECH_KEY=
# Compatible Images / Transcriptions APIs.
COMPANION_IMAGE_BASE_URL=
COMPANION_IMAGE_MODEL=
COMPANION_IMAGE_KEY=
COMPANION_TRANSCRIPTION_BASE_URL=
COMPANION_TRANSCRIPTION_MODEL=
COMPANION_TRANSCRIPTION_KEY=

# Private owner-controlled MCP only; keys will pass through host chat/tool arguments.
# Disabled by default. Not for published ChatGPT plugin credential collection.
# COMPANION_ALLOW_CHAT_CREDENTIALS=1

# Optional live calls: install .[calls], configure speech above + character voice_id.
# ASR can require a separate key and a specifically granted resource.
COMPANION_CALL_ASR_KEY=
COMPANION_CALL_ASR_RESOURCE=volc.seedasr.sauc.duration
# Optional Vidu S2 Component + managed Volcengine RTC; character reference image required.
COMPANION_VIDU_KEY=
COMPANION_VIDU_BASE_URL=https://api.vidu.com
